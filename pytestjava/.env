# API Configuration
API_BASE_URL=http://localhost:8080
API_VERSION=v1

# Test Configuration
TEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=1

# Authentication
TEST_PHONE_NUMBER=13800138000
TEST_VERIFICATION_CODE=123456
DEFAULT_DEVICE_ID=web-test-001

# WeChat Work Configuration
WECHAT_WORK_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send
WECHAT_WORK_KEY=your_webhook_key_here

# Allure Configuration
ALLURE_RESULTS_DIR=./allure-results
ALLURE_REPORT_DIR=./allure-report

# CI/CD Configuration
CI_COMMIT_SHA=${CI_COMMIT_SHA}
CI_BUILD_NUMBER=${CI_BUILD_NUMBER}
CI_JOB_URL=${CI_JOB_URL}

# Git Configuration
GIT_REPO_PATH=git@github.com:ytfyd/mallaitest.git
GIT_BRANCH=master