      "body": "    public Set<String> getMenuPermissionByRoleId(Long roleID) {\n        Set<String> perms = new HashSet<String>();\n        // 管理员拥有所有权限\n        if (roleID == 1) {\n            perms.add(\"*:*:*\");\n        } else {\n            perms = menuService.selectMenuPermsByRoleId(roleID);\n        }\n        return perms;\n    }",
