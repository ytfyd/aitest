      "body": "    public Set<String> getRolePermission(SysUserEntity user) {\n        Set<String> roles = new HashSet<String>();\n        // 管理员拥有所有权限\n        if (user.isAdmin()) {\n            roles.add(\"admin\");\n        } else {\n            roles.addAll(roleService.selectRolePermissionByUserId(user.getUserId()));\n        }\n        return roles;\n    }",
