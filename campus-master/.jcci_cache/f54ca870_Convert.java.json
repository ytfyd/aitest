      "line_start": 797,
      "line_end": 814,
      "body": "    public static String toDBC(String text, Set<Character> notConvertSet) {\n        char[] c = text.toCharArray();\n        for (int i = 0; i < c.length; i++) {\n            if (null != notConvertSet && notConvertSet.contains(c[i])) {\n                // 跳过不替换的字符\n                continue;\n            }\n\n            if (c[i] == '\\u3000') {\n                c[i] = ' ';\n            } else if (c[i] > '\\uFF00' && c[i] < '\\uFF5F') {\n                c[i] = (char) (c[i] - 65248);\n            }\n        }\n        String returnString = new String(c);\n\n        return returnString;\n    }",
