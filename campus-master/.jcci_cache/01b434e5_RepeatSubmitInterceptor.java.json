      "line_start": 23,
      "line_end": 39,
      "body": "    public boolean preHandle(HttpServletRequest request, HttpServletResponse response, Object handler) throws Exception {\n        if (handler instanceof HandlerMethod) {\n            HandlerMethod handlerMethod = (HandlerMethod) handler;\n            Method method = handlerMethod.getMethod();\n            RepeatSubmit annotation = method.getAnnotation(RepeatSubmit.class);\n            if (annotation != null) {\n                if (this.isRepeatSubmit(request, annotation)) {\n                    R r = R.error(annotation.message());\n                    ServletUtils.renderString(response, JSON.toJSONString(r));\n                    return false;\n                }\n            }\n            return true;\n        } else {\n            return true;\n        }\n    }",
